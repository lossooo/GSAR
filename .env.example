# OpenAI-compatible model endpoint used by synthesis and verification.
GSAR_API_KEY=
GSAR_BASE_URL=https://api.openai.com/v1
GSAR_MODEL=gpt-4o

# Optional header used by gateways that route requests to a provider.
# GSAR_MODEL_PROVIDER_ID=azure_openai

# Optional configuration overrides.
# GSAR_ROOT=/absolute/path/to/GSAR
# GSAR_DATA_SYNTHESIS_CONFIG=configs/data_synthesis.yaml
# GSAR_VERIFICATION_CONFIG=configs/verification.yaml
